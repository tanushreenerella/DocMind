# Backend the Next.js server proxies /api/* to (no trailing slash).
# Server-side only and read at build time — set it before `next build`.
# Development:
BACKEND_URL=http://localhost:8000
# Production (Render):
# BACKEND_URL=https://your-backend.onrender.com

# Shared secret sent to the backend as x-proxy-secret; must equal the backend's
# PROXY_SECRET. Server-side only (never NEXT_PUBLIC_). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PROXY_SECRET=change-me
