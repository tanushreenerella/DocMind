# Required
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
# Chroma Cloud (all three required; startup fails if any is missing).
# Local dev and production must use DIFFERENT databases so local uploads never
# land in prod. Create a "docmind-dev" database in the Chroma Cloud dashboard
# and an API key scoped to it for this file; Render gets the prod database/key.
CHROMA_API_KEY=your_chroma_cloud_dev_api_key
CHROMA_TENANT=your_chroma_tenant_id
CHROMA_DATABASE=docmind-dev
# PostgreSQL connection string (required).
DATABASE_URL=postgresql://user:password@host:5432/docmind
# Signs auth cookies (required). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me
# Optional overrides (defaults shown)
# Comma-separated, no spaces or brackets.
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
MAX_FILE_SIZE_MB=20
STORAGE_PATH=./storage
CHROMA_PATH=./storage/chroma_db
LOCAL_OBJECTS_PATH=./storage/objects
RATE_LIMIT_PER_MINUTE=30
HYBRID_SEARCH_ENABLED=false
JWT_EXPIRE_MINUTES=60
# Set to false only for plain-http local dev on a non-localhost host.
COOKIE_SECURE=true
# Required: must equal the frontend's PROXY_SECRET. /api requests without it get 403.
PROXY_SECRET=change-me
# Login attempts allowed per email (case-insensitive), across all IPs.
RATE_LIMIT_LOGIN_EMAIL=10/15 minutes
# Cloudflare R2 for PDFs and page images (private bucket; files are streamed
# through the API after an ownership check). Set all four, or none to store
# them on local disk under LOCAL_OBJECTS_PATH (above).
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET=docmind
